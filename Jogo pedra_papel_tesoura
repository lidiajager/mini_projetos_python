#recebe dos jogadores a escolha
jogador1 = input("Escolha pedra, papel ou tesoura: ").lower() # o lower faz com que o programa aceite qualquer variação de letra maiuscula dada pelo usuário
jogador2 = input("Escolha pedra, papel ou tesoura: ").lower()

# interpreta as vantagens

if jogador1 == jogador2:
    print("Empate!")

elif (
    (jogador1 == "pedra" and jogador2 == "tesoura") or
    (jogador1 == "tesoura" and jogador2 == "papel") or
    (jogador1 == "papel" and jogador2 == "pedra")
):
    print("Jogador 1 venceu!")

else:
    print("Jogador 2 venceu!")
