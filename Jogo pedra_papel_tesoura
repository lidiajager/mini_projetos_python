# Pedra papel tesoura - jogo

# Explica o jogo ao usuário

print("__JOGO PEDRA PAPEL TESOURA (2 jogadores)__")
print("Bem vindos! Cada jogador escolhe uma das opções")
opcoes_validas = ("pedra", "papel", "tesoura")
print(f"Opções válidas: {opcoes_validas}")
print("-" *25) # imprime uma linha para separar

# Recebe escolha do usuário
jogador1 = input("Escolha: pedra, papel ou tesoura: ").lower().strip()
jogador2 = input("Escolha: pedra, papel ou tesoura: ").lower().strip() # lower e strip -> reconhece qualquer entrada maiuscula e retira espaçoes extras caso tenha

#interpretando as respostas
if jogador1 == jogador2:
    print("Empate!")

elif (
    (jogador1 == "pedra" and jogador2 == "tesoura") or
    (jogador1 == "tesoura" and jogador2 == "papel") or
    (jogador1 == "papel" and jogador2 == "pedra")
):
    print("Jogador 1 venceu!")

else:
    print("Jogador 2 venceu!")

print("______FIM DE JOGO________")


















